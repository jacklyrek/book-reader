{
  "name": "public-domain-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first PWA for reading and listening to public domain books on iOS.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest": "node --experimental-strip-types supabase/ingest/run.ts",
    "worker:dev": "npm --prefix worker run dev",
    "worker:deploy": "npm --prefix worker run deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "foliate-js": "^1.0.1",
    "idb": "^8.0.3",
    "preact": "^10.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.2",
    "typescript": "^5.9.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
