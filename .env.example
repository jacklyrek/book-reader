# Copy to .env and fill in. Everything here is optional: with no configuration
# the app runs in local-only mode against the live public APIs (§6.2 fallback).

# --- CORS proxy (§6.1) -------------------------------------------------------
# Deployed Cloudflare Worker. Without it, Gutenberg/LibriVox fetches fail CORS.
VITE_PROXY_BASE=https://proxy.example.com

# Shared secret used to HMAC-sign proxy URLs. Must match the Worker's PROXY_HMAC_KEY.
# Leave empty to send unsigned requests (the Worker will accept them only if it
# was deployed with REQUIRE_SIGNATURE=false).
VITE_PROXY_HMAC_KEY=

# --- Catalog + sync (§6.2, §6.3) --------------------------------------------
# Without these the app uses the live-API catalog adapter and keeps all state
# on-device. Setting them turns on auth + cross-device sync of your library,
# reading/listening progress, and annotations (tables from
# supabase/migrations/0002_sync.sql) — search still uses the live APIs.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to "true" to also switch search/browse to the Supabase-backed catalog
# index (0001_catalog.sql + 0003_match.sql) instead of the live APIs. Only do
# this after running `npm run ingest`, or the tables are empty and every
# search comes back blank.
VITE_SUPABASE_CATALOG=

# --- Ingest job (server-side only, never exposed to the client) -------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Standard Ebooks' bulk OPDS feed is behind HTTP Basic auth (Patrons Circle
# email as username, empty password). Without it the ingest falls back to the
# public new-releases feed, which only carries the 15 most recent books.
SE_OPDS_EMAIL=
